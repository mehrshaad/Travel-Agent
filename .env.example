# Copy to .env.local — NEVER commit .env.local
OPENROUTER_API_KEY=
EXA_API_KEY=

# Soft cap. Free-text search degrades to Overpass past this.
EXA_BUDGET_USD=10
EXA_SOFT_CAP_RATIO=0.8

# Nominatim requires a real, identifying User-Agent or it blocks you.
NOMINATIM_USER_AGENT=RoamPilot/0.1 (hackathon; contact@example.com)

# Set to 1 to force every provider into fixture mode globally.
MOCK_MODE=0
